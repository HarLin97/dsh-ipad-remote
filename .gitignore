node_modules/
# lib/ is deliberately NOT ignored: this package ships its build output so a
git install (dsh plugin add github:owner/repo#path:/packages/ipad-remote)
needs no build step, which pnpm would otherwise block as an unapproved script.
# `client/` is the built browser bundle. It is committed for the same reason as
# lib/: git installs must not need a build. `src/client/` is separate source.
dist/
*.tgz
*.tsbuildinfo
*.log
.DS_Store
.run-dsh-home/
.run-home/
.probe-home/


# Generated by scripts/verify-settings-ui.mjs — screenshots are evidence for a
# local run, not something to publish (they show the operator own screens).
docs/verification/
docs/verify-*.png
